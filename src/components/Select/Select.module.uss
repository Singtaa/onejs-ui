.trigger {
    flex-grow: 1;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.triggerLabel {
    color: var(--ojs-fg);
    font-size: var(--ojs-font-size-md);
}

.caret {
    color: var(--ojs-fg-muted);
    font-size: var(--ojs-font-size-md);
    margin-left: var(--ojs-space-2);
}

/* Menu surface. No box-shadow in UI Toolkit, so depth comes from the overlay
   surface + border contrast. */
.menu {
    min-width: 180px;
    background-color: var(--ojs-overlay);
    border-radius: var(--ojs-radius-md);
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-color: var(--ojs-border);
    border-bottom-color: var(--ojs-border);
    border-left-color: var(--ojs-border);
    border-right-color: var(--ojs-border);
    padding-top: 4px;
    padding-bottom: 4px;
    /* Overlay surface skin slot (shared across overlays). No-op by default. */
    background-image: var(--ojs-surface-image, none);
    -unity-slice-left: var(--ojs-surface-slice, 0);
    -unity-slice-right: var(--ojs-surface-slice, 0);
    -unity-slice-top: var(--ojs-surface-slice, 0);
    -unity-slice-bottom: var(--ojs-surface-slice, 0);
    -unity-slice-scale: var(--ojs-surface-slice-scale, 1px);
}

.option {
    flex-direction: row;
    align-items: center;
    padding-top: var(--ojs-space-2);
    padding-bottom: var(--ojs-space-2);
    padding-left: var(--ojs-space-3);
    padding-right: var(--ojs-space-3);
    transition-property: background-color;
    transition-duration: var(--ojs-motion-fast);
    transition-timing-function: var(--ojs-ease);
}

.option:hover {
    background-color: var(--ojs-overlay-hover);
}

.optionSelected {
    background-color: var(--ojs-overlay-hover);
}

/* Keyboard highlight. Same treatment as :hover, plus the ring token, so an
   option reached by arrow key reads the way the rest of the library reads under
   keyboard focus. The options are not focus targets themselves (see
   useMenuNavigation), so this cannot be a :focus rule. */
.optionActive {
    background-color: var(--ojs-overlay-hover);
    border-left-width: var(--ojs-focus-width, 2px);
    border-left-color: var(--ojs-ring);
}

.optionDisabled {
    opacity: 0.5;
}

.optionText {
    color: var(--ojs-fg);
    font-size: var(--ojs-font-size-md);
}
